<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.7'>
  <world name='default'>

    <gui fullscreen='0'>
      <plugin filename='MinimalScene' name='3D View'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0 0 14 0 1.57 1.57</camera_pose>
      </plugin>

      <!-- 场景管理器：将仿真状态同步到渲染场景 -->
      <plugin filename='GzSceneManager' name='Scene Manager'>
        <gz-gui>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
      </plugin>

      <!-- 鼠标交互视角控制 -->
      <plugin filename='InteractiveViewControl' name='Interactive view control'>
        <gz-gui>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
      </plugin>

      <!-- 仿真控制：播放/暂停/步进 -->
      <plugin filename='WorldControl' name='World control'>
        <gz-gui>
          <title>World control</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>floating</property>
          <property type='double' key='x'>0</property>
          <property type='double' key='y'>0</property>
          <property type='double' key='width'>250</property>
          <property type='double' key='height'>50</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- 仿真统计信息 -->
      <plugin filename='WorldStats' name='World stats'>
        <gz-gui>
          <title>World stats</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>floating</property>
          <property type='double' key='x'>250</property>
          <property type='double' key='y'>0</property>
          <property type='double' key='width'>250</property>
          <property type='double' key='height'>50</property>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>

      <!-- 实体树：左侧列出 world 内所有 model/link，点击即选中 -->
      <plugin filename='EntityTree' name='Entity tree'>
        <gz-gui>
          <title>Entity tree</title>
          <property type='string' key='state'>docked</property>
        </gz-gui>
      </plugin>

      <!-- 组件检查器：显示选中实体的位姿、质量、惯量等属性 -->
      <plugin filename='ComponentInspector' name='Component inspector'>
        <gz-gui>
          <title>Component inspector</title>
          <property type='string' key='state'>docked</property>
        </gz-gui>
      </plugin>

      <!-- 平移/旋转/缩放操作柄（选中实体后可拖动） -->
      <plugin filename='TransformControl' name='Transform control'>
        <gz-gui>
          <title>Transform control</title>
          <property type='string' key='state'>floating</property>
          <property type='double' key='x'>0</property>
          <property type='double' key='y'>50</property>
          <property type='double' key='width'>250</property>
          <property type='double' key='height'>50</property>
        </gz-gui>
      </plugin>

      <!-- 右键菜单：跟随/移动到/删除实体 -->
      <plugin filename='EntityContextMenuPlugin' name='Entity context menu'>
        <gz-gui>
          <property key='state' type='string'>floating</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='showTitleBar' type='bool'>false</property>
        </gz-gui>
      </plugin>

      <!-- 视角工具：切换正交/透视、预设视角 -->
      <plugin filename='CameraTracking' name='Camera Tracking'>
        <gz-gui>
          <property key='resizable' type='bool'>false</property>
          <property key='width' type='double'>5</property>
          <property key='height' type='double'>5</property>
          <property key='state' type='string'>floating</property>
          <property key='showTitleBar' type='bool'>false</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Global RGL scene manager required to upload meshes to GPU -->
    <plugin name='rgl::RGLServerPluginManager' filename='RGLServerPluginManager'>
      <do_ignore_entities_in_lidar_link>true</do_ignore_entities_in_lidar_link>
    </plugin>

    <!-- Physics -->
    <plugin filename="libgz-sim-physics-system.so" name="gz::sim::systems::Physics">
    </plugin>

    <!-- Forwards simulation state to the GUI -->
    <plugin filename="libgz-sim-scene-broadcaster-system.so" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Processes user commands, like translate and create -->
    <plugin filename="libgz-sim-user-commands-system.so" name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Generates rendering sensor data -->
    <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu">
    </plugin>


    <light type='directional' name='direct_light'>
      <visualize>false</visualize>
      <cast_shadows>true</cast_shadows>
      <pose>14.6 7.9 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <!-- 20 m x 15 m 平整场地 -->
    <model name='flat_enclosed_arena'>
      <static>true</static>

      <link name='ground'>
        <collision name='collision'>
          <geometry>
            <box><size>20 15 0.1</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>20 15 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
            <roughness>0.9</roughness>
          </material>
        </visual>
        <pose>0 0 -0.05 0 0 0</pose>
      </link>

      <!-- 围墙高 1.5 m、厚 0.2 m，内侧可用区域约 19.8 m x 14.8 m -->
      <link name='north_wall'>
        <pose>0 7.5 0.75 0 0 0</pose>
        <collision name='collision'><geometry><box><size>20 0.2 1.5</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>20 0.2 1.5</size></box></geometry><material><ambient>0.35 0.4 0.45 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material></visual>
      </link>
      <link name='south_wall'>
        <pose>0 -7.5 0.75 0 0 0</pose>
        <collision name='collision'><geometry><box><size>20 0.2 1.5</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>20 0.2 1.5</size></box></geometry><material><ambient>0.35 0.4 0.45 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material></visual>
      </link>
      <link name='east_wall'>
        <pose>10 0 0.75 0 0 0</pose>
        <collision name='collision'><geometry><box><size>0.2 15 1.5</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.2 15 1.5</size></box></geometry><material><ambient>0.35 0.4 0.45 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material></visual>
      </link>
      <link name='west_wall'>
        <pose>-10 0 0.75 0 0 0</pose>
        <collision name='collision'><geometry><box><size>0.2 15 1.5</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.2 15 1.5</size></box></geometry><material><ambient>0.35 0.4 0.45 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material></visual>
      </link>

      <!-- 两个障碍物，保留中心和机器人出生点附近的通行空间 -->
      <link name='obstacle_box_northwest'>
        <pose>-4 2.5 0.6 0 0 0.25</pose>
        <collision name='collision'><geometry><box><size>2.5 1.2 1.2</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>2.5 1.2 1.2</size></box></geometry><material><ambient>0.75 0.25 0.15 1</ambient><diffuse>0.85 0.3 0.18 1</diffuse></material></visual>
      </link>

      <link name='obstacle_box_southeast'>
        <pose>4 -2.5 0.75 0 0 -0.35</pose>
        <collision name='collision'><geometry><box><size>3 1 1.5</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>3 1 1.5</size></box></geometry><material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.18 0.42 0.85 1</diffuse></material></visual>
      </link>

    </model>
  </world>
</sdf>
