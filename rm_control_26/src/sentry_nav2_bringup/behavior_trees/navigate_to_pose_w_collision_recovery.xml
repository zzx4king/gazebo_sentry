<!--
  Replan continuously and recover from controller collision/progress failures.
  Recovery order prioritizes clearing stale observations and backing away from
  the obstacle before attempting rotation, then returns to global replanning.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="8" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="SmoothPath">
          <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="minco_smoother" error_code_id="{smooth_path_error_code}"/>
          <Sequence>
            <WouldASmootherRecoveryHelp error_code="{smooth_path_error_code}"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Smoothing" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
        </RecoveryNode>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
          <WouldASmootherRecoveryHelp error_code="{smooth_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearAndBackAway">
              <ClearEntireCostmap name="ClearLocalBeforeBackUp" service_name="local_costmap/clear_entirely_local_costmap"/>
              <BackUp backup_dist="0.35" backup_speed="0.12" time_allowance="6.0" error_code_id="{backup_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalAfterBackUp" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.20" time_allowance="8.0" error_code_id="{spin_error_code}"/>
            <Sequence name="ShortBackAway">
              <BackUp backup_dist="0.18" backup_speed="0.08" time_allowance="4.0" error_code_id="{backup_error_code}"/>
              <Wait wait_duration="1.0"/>
            </Sequence>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
